# ==============================================
# �� ОБЩИЕ ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ ВСЕГО ПРОЕКТА
# ==============================================

# Django Backend Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend URL (обновлен на порт 3000)
FRONTEND_URL=http://localhost:3000

# ==============================================
# 🗄️ БАЗА ДАННЫХ
# ==============================================

# Разработка (SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Продакшн (PostgreSQL) - раскомментировать при деплое
# DATABASE_URL=postgresql://username:password@localhost:5432/icambio_db

# ==============================================
# �� POSTGRESQL НАСТРОЙКИ (для продакшна)
# ==============================================

# Основные настройки PostgreSQL
# POSTGRES_DB=icambio_db
# POSTGRES_USER=icambio_user
# POSTGRES_PASSWORD=your-secure-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Дополнительные настройки PostgreSQL
# POSTGRES_OPTIONS=-c search_path=public
# POSTGRES_SSL_MODE=require
# POSTGRES_SSL_CERT=
# POSTGRES_SSL_KEY=
# POSTGRES_SSL_ROOT_CERT=

# ==============================================
# �� JWT НАСТРОЙКИ (DRF Simple JWT)
# ==============================================

# Секретный ключ для JWT токенов
JWT_SECRET_KEY=your-jwt-secret-key-here

# Время жизни токенов (в часах)
JWT_ACCESS_TOKEN_LIFETIME=5
JWT_REFRESH_TOKEN_LIFETIME=24

# ==============================================
# 📧 EMAIL SETTINGS (Django Allauth)
# ==============================================

# SMTP настройки для отправки email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Для разработки можно использовать консольный вывод
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ==============================================
# 🎯 Frontend (Vite) переменные
# ==============================================

# API URL для фронтенда
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=iCambio

# ==============================================
# 🔧 ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# ==============================================

# CORS настройки
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Статические файлы
STATIC_URL=/static/
MEDIA_URL=/media/

# Логирование
LOG_LEVEL=INFO

# ==============================================
# �� ПРОДАКШН НАСТРОЙКИ (раскомментировать при деплое)
# ==============================================

# Безопасность
# DEBUG=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Кэширование (Redis)
# REDIS_URL=redis://localhost:6379/0
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache

# Celery (для асинхронных задач)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0